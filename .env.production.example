# ==============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================
# This file contains production-ready environment variables
# Copy this to .env and update with your actual production values

# ==============================================
# APPLICATION SETTINGS
# ==============================================
APP_NAME="Corporate LMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://lms.yourcompany.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=database
APP_MAINTENANCE_STORE=database

# Password hashing rounds (higher for production)
BCRYPT_ROUNDS=12

# ==============================================
# LOGGING CONFIGURATION
# ==============================================
LOG_CHANNEL=stack
LOG_STACK=daily,slack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Slack logging for critical errors
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME="LMS Error Bot"
LOG_SLACK_EMOJI=":boom:"
LOG_SLACK_LEVEL=error

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
DB_CONNECTION=mysql
DB_HOST=your-production-db-host.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=corporate_lms_production
DB_USERNAME=lms_user
DB_PASSWORD=

# Database connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT=30

# Read replica configuration (optional)
DB_READ_HOST=your-read-replica-host.rds.amazonaws.com
DB_READ_PORT=3306

# ==============================================
# SESSION CONFIGURATION
# ==============================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.yourcompany.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ==============================================
# CACHE CONFIGURATION
# ==============================================
CACHE_STORE=redis
CACHE_PREFIX=lms_prod
CACHE_TTL=3600

# ==============================================
# QUEUE CONFIGURATION
# ==============================================
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database

# ==============================================
# REDIS CONFIGURATION
# ==============================================
REDIS_CLIENT=predis
REDIS_HOST=your-redis-cluster.cache.amazonaws.com
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3

# Redis Sentinel (if using)
REDIS_SENTINEL_SERVICE=mymaster
REDIS_SENTINELS=

# Redis Cluster (if using)
REDIS_CLUSTER=false

# ==============================================
# FILESYSTEM & STORAGE
# ==============================================
FILESYSTEM_DISK=s3
FILESYSTEM_CLOUD=s3

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=corporate-lms-production
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# S3 specific settings
AWS_BUCKET_VIDEOS=corporate-lms-videos
AWS_BUCKET_DOCUMENTS=corporate-lms-documents
AWS_BUCKET_CERTIFICATES=corporate-lms-certificates
AWS_BUCKET_AVATARS=corporate-lms-avatars

# CloudFront CDN (optional)
AWS_CLOUDFRONT_URL=https://d1234567890.cloudfront.net
AWS_CLOUDFRONT_KEY_PAIR_ID=
AWS_CLOUDFRONT_PRIVATE_KEY_PATH=

# ==============================================
# MAIL CONFIGURATION
# ==============================================
MAIL_MAILER=smtp
MAIL_HOST=email-smtp.us-east-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourcompany.com"
MAIL_FROM_NAME="${APP_NAME}"

# Alternative: SES
# MAIL_MAILER=ses
# AWS_SES_REGION=us-east-1

# ==============================================
# BROADCASTING
# ==============================================
BROADCAST_CONNECTION=pusher

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=us2

# Alternative: Laravel WebSockets
# BROADCAST_CONNECTION=redis
# LARAVEL_WEBSOCKETS_SSL_LOCAL_CERT=
# LARAVEL_WEBSOCKETS_SSL_LOCAL_PK=

# ==============================================
# OPENAI CONFIGURATION
# ==============================================
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=3

# Rate limiting for AI services
OPENAI_RATE_LIMIT_PER_MINUTE=60
OPENAI_RATE_LIMIT_PER_DAY=10000

# Fallback AI service
FALLBACK_AI_SERVICE=gemini
GEMINI_API_KEY=

# ==============================================
# SEARCH CONFIGURATION (Scout)
# ==============================================
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
SCOUT_CHUNK_SIZE=500

# Meilisearch
MEILISEARCH_HOST=https://your-meilisearch-instance.com
MEILISEARCH_KEY=

# Alternative: Algolia
# SCOUT_DRIVER=algolia
# ALGOLIA_APP_ID=
# ALGOLIA_SECRET=

# ==============================================
# HORIZON CONFIGURATION
# ==============================================
HORIZON_PREFIX=horizon_prod:
HORIZON_BALANCE=auto
HORIZON_MIN_PROCESSES=1
HORIZON_MAX_PROCESSES=10
HORIZON_BALANCE_MAX_SHIFT=1
HORIZON_BALANCE_COOLDOWN=3

# Horizon authentication
HORIZON_DOMAIN=lms.yourcompany.com
HORIZON_PATH=admin/horizon
HORIZON_MIDDLEWARE=web,auth,admin

# ==============================================
# FILE UPLOAD CONFIGURATION
# ==============================================
UPLOAD_DISK=s3
MAX_VIDEO_SIZE=1048576
MAX_PDF_SIZE=102400
MAX_PRESENTATION_SIZE=102400
MAX_SCORM_SIZE=204800
MAX_IMAGE_SIZE=10240

# Video Processing
VIDEO_GENERATE_THUMBNAIL=true
VIDEO_THUMBNAIL_TIME=5
VIDEO_PROCESS_ON_UPLOAD=true
VIDEO_DEFAULT_QUALITY=high
VIDEO_QUEUE=video-processing

# FFmpeg Configuration
FFMPEG_ENABLED=true
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
FFMPEG_TIMEOUT=7200

# Chunked Upload
CHUNKED_UPLOAD_ENABLED=true
CHUNKED_UPLOAD_SIZE=10240
CHUNKED_UPLOAD_MAX_CHUNKS=200

# SCORM Configuration
SCORM_VALIDATE_MANIFEST=true

# ==============================================
# SECURITY CONFIGURATION
# ==============================================
# Rate limiting
RATE_LIMIT_API=60
RATE_LIMIT_AUTH=5
RATE_LIMIT_GLOBAL=1000

# CSRF
SANCTUM_STATEFUL_DOMAINS=lms.yourcompany.com,www.yourcompany.com

# Content Security Policy
CSP_ENABLED=true

# 2FA
TWO_FACTOR_ENABLED=true

# Password policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# ==============================================
# MONITORING & ERROR TRACKING
# ==============================================
# Sentry
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_ENVIRONMENT=production

# New Relic
NEW_RELIC_ENABLED=false
NEW_RELIC_APP_NAME="Corporate LMS"
NEW_RELIC_LICENSE_KEY=

# DataDog
DATADOG_ENABLED=false
DATADOG_API_KEY=
DATADOG_APP_KEY=

# ==============================================
# PERFORMANCE OPTIMIZATION
# ==============================================
# Opcache
OPCACHE_ENABLED=true

# View caching
VIEW_CACHE_ENABLED=true

# Route caching
ROUTE_CACHE_ENABLED=true

# Config caching
CONFIG_CACHE_ENABLED=true

# Query caching
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL=3600

# ==============================================
# BACKUP CONFIGURATION
# ==============================================
BACKUP_ENABLED=true
BACKUP_DISK=s3
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
BACKUP_NOTIFICATION_EMAIL=admin@yourcompany.com

# Database backup
DB_BACKUP_ENABLED=true
DB_BACKUP_COMPRESS=true

# File backup
FILE_BACKUP_ENABLED=true
FILE_BACKUP_EXCLUDE=temp,cache,logs

# ==============================================
# CERTIFICATE CONFIGURATION
# ==============================================
CERTIFICATE_STORAGE_DISK=s3
CERTIFICATE_PUBLIC_VERIFICATION=true
CERTIFICATE_EXPIRY_ENABLED=true
CERTIFICATE_DEFAULT_VALIDITY_DAYS=365

# ==============================================
# ANALYTICS CONFIGURATION
# ==============================================
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=730
ANALYTICS_AGGREGATION_SCHEDULE="0 1 * * *"

# Google Analytics (optional)
GOOGLE_ANALYTICS_ID=

# ==============================================
# MAINTENANCE MODE
# ==============================================
MAINTENANCE_MODE_SECRET=
MAINTENANCE_MODE_ALLOWED_IPS=

# ==============================================
# VITE CONFIGURATION
# ==============================================
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ==============================================
# TRUSTED PROXIES
# ==============================================
TRUSTED_PROXIES=*
TRUSTED_HOSTS=lms.yourcompany.com

# ==============================================
# CORS CONFIGURATION
# ==============================================
CORS_ALLOWED_ORIGINS=https://lms.yourcompany.com
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_EXPOSED_HEADERS=
CORS_MAX_AGE=3600
CORS_SUPPORTS_CREDENTIALS=true
